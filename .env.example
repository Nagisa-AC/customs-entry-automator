# Variables the CLI reads from the environment. Nothing loads a .env file
# automatically. Never commit real keys.

# OpenAI-compatible provider (--provider openai)
OPENAI_API_KEY=
CEA_OPENAI_MODEL=
# Optional: compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=

# Anthropic provider (--provider anthropic)
ANTHROPIC_API_KEY=
CEA_ANTHROPIC_MODEL=
# Optional
ANTHROPIC_BASE_URL=

# Data-terms attestations (CEA_PROVIDER_ZERO_RETENTION, CEA_PROVIDER_REGION) are
# deliberately not listed here. Set them per command, inline, and only after
# verifying the account's zero-retention and US-region terms; never in .env or
# a shell profile:
#   CEA_PROVIDER_ZERO_RETENTION=confirmed CEA_PROVIDER_REGION=us pnpm cea run ... --provider anthropic
