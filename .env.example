# Copy to .env (git-ignored) or export in your shell. Never commit real keys.

# OpenAI-compatible provider (--provider openai)
OPENAI_API_KEY=
CEA_OPENAI_MODEL=
# Optional: US-region or compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=

# Anthropic provider (--provider anthropic)
ANTHROPIC_API_KEY=
CEA_ANTHROPIC_MODEL=
# Optional
ANTHROPIC_BASE_URL=
# Optional anthropic-beta header value if structured outputs require one
CEA_ANTHROPIC_BETA=
