# Copy to .env (git-ignored) or export in your shell. Never commit real keys.

# OpenAI-compatible provider (--provider openai)
OPENAI_API_KEY=
CEA_OPENAI_MODEL=
# Optional: US-region or compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=

# Anthropic provider (--provider anthropic)
ANTHROPIC_API_KEY=
CEA_ANTHROPIC_MODEL=
# Optional
ANTHROPIC_BASE_URL=

# Required for any real provider. Set ONLY after verifying the account's
# contract: zero data retention and US-region processing. Until then real
# providers refuse to start; do not run real broker invoices.
CEA_PROVIDER_ZERO_RETENTION=
CEA_PROVIDER_REGION=
